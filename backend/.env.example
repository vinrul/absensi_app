# Backend environment (salin menjadi `.env`)
APP__DATABASE_URL=postgres://kinerja:kinerja_dev@127.0.0.1:5433/kinerja
APP__HOST=127.0.0.1
APP__PORT=8080
APP__JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
APP__ACCESS_TOKEN_TTL_MINUTES=15
APP__REFRESH_TOKEN_TTL_DAYS=30
APP__UPLOAD_DIR=../deploy/data/uploads
APP__RUN_MIGRATIONS=true
APP__CORS_ORIGINS=http://localhost:5173,http://localhost:8088
RUST_LOG=info,kinerja_api=debug,sqlx=warn
