# Contoh konfigurasi signing Android.
#
# Salin berkas ini menjadi android/keystore.properties, lalu isi nilai sebenarnya.
# android/keystore.properties sudah masuk .gitignore dan tidak boleh di-commit.
#
# storeFile boleh absolute (Windows: E:/folder/siopa.jks atau E:\\folder\\siopa.jks)
# atau relatif terhadap folder android/.

storeFile=E:/new_disposisi/siopa.jks
storePassword=GANTI_STORE_PASSWORD
keyAlias=GANTI_KEY_ALIAS
keyPassword=GANTI_KEY_PASSWORD
