<?xml version="1.0" encoding="utf-8"?>
<!--
  Override khusus build debug: emulator mengakses API lokal lewat HTTP
  (http://10.0.2.2:8080). Build release memakai res/xml di src/main yang
  menetapkan cleartextTrafficPermitted="false".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
